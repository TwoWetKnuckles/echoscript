{
  "name": "echoscript",
  "version": "0.2.0-dev",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "node tools/build.mjs && tsc",
    "typecheck": "tsc --noEmit",
    "test": "node tools/build.mjs --schema-only && tsc && node --test tests/*.test.mjs",
    "serve": "node tools/serve.mjs",
    "api": "node build/services/api/src/index.js",
    "qa:local": "node --expose-gc tools/qa-local.mjs",
    "lint": "eslint 'packages/**/*.mjs' 'tools/**/*.mjs' 'tests/**/*.mjs' 'apps/web/src/*.mjs' eslint.config.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "ajv": "8.20.0",
    "fastify": "5.12.8",
    "fflate": "0.8.3",
    "json-canonicalize": "3.0.1",
    "jspdf": "4.2.1",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  },
  "overrides": {
    "eslint": {
      "minimatch": "11.0.1"
    },
    "@eslint/config-array": {
      "minimatch": "11.0.1"
    }
  }
}
