{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://echoscript.invalid/schemas/checkpoint-v1.json",
  "title": "EchoScript device-key historical checkpoint v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "payload", "publicKeySpki", "signature"],
  "properties": {
    "schema": { "const": "org.echoscript.checkpoint/1" },
    "publicKeySpki": { "type": "string", "minLength": 1, "maxLength": 1368 },
    "signature": { "type": "string", "minLength": 1, "maxLength": 108 },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "actor",
        "createdAtUtc",
        "caseId",
        "keySha256",
        "snapshotSha256",
        "snapshot"
      ],
      "properties": {
        "algorithm": { "const": "ECDSA_P256_SHA256" },
        "actor": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAtUtc": { "type": "string", "minLength": 20, "maxLength": 40 },
        "caseId": { "type": "string", "pattern": "^[0-9a-f-]{36}$" },
        "keySha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "snapshotSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "snapshot": {
          "$ref": "https://echoscript.invalid/schemas/case-v1.json"
        }
      }
    }
  }
}
